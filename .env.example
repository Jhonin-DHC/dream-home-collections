# MongoDB
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/dream-home-collections

# Auth
AUTH_SECRET=replace-with-long-random-string
ADMIN_EMAIL=admin@dreamhomecollections.com
ADMIN_PASSWORD=replace-with-strong-password

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare R2 image uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dhc-media
R2_PUBLIC_BASE_URL=https://media.dreamhomecollections.com

# SMTP email (inquiries, password reset, team alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM="Dream Home Collections <concierge@dreamhomecollections.com>"
SMTP_USER=
SMTP_PASS=
# Comma-separated team inboxes for new inquiries
INQUIRY_NOTIFY_EMAILS=concierge@dreamhomecollections.com
